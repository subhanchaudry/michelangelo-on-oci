# Pinned upstream SQLite, built with parser regeneration to retain UPDATE/DELETE LIMIT.
FROM python@sha256:2b4f19dae3a777dfc3b76730bda1e82e1f66ab2a2686fa93ca78edbfb4f04ffe AS sqlite-security-builder
USER 0:0
RUN apt-get update && apt-get install -y --no-install-recommends build-essential pkg-config tcl-dev && rm -rf /var/lib/apt/lists/*
RUN python3 -c "import urllib.request,hashlib; data=urllib.request.urlopen('https://sqlite.org/2026/sqlite-src-3540100.zip',timeout=120).read(); assert hashlib.sha256(data).hexdigest()=='387e7f6cad4797b17848c07d453dc6606917bb356a6cfe5a3abafd38c240c71b'; open('/tmp/sqlite.zip','wb').write(data)"
RUN python3 -c "import hashlib; assert hashlib.sha3_256(open('/tmp/sqlite.zip','rb').read()).hexdigest() == '877c6f4996ce7adb368686bce21638de9e3d91534832ad3d9d119037d1bc22ad'"
RUN python3 -c "import zipfile; zipfile.ZipFile('/tmp/sqlite.zip').extractall('/tmp/source')" && mv /tmp/source/sqlite-src-3540100 /build && chmod +x /build/configure /build/autosetup/autosetup-find-tclsh /build/autosetup/jimsh0.c
WORKDIR /build
ENV CFLAGS="-O2 -fstack-protector-strong -D_FORTIFY_SOURCE=2 -DSQLITE_ENABLE_COLUMN_METADATA -DSQLITE_ENABLE_DBPAGE_VTAB -DSQLITE_ENABLE_DBSTAT_VTAB -DSQLITE_ENABLE_FTS3 -DSQLITE_ENABLE_FTS3_PARENTHESIS -DSQLITE_ENABLE_FTS3_TOKENIZER -DSQLITE_ENABLE_FTS4 -DSQLITE_ENABLE_FTS5 -DSQLITE_ENABLE_MATH_FUNCTIONS -DSQLITE_ENABLE_PREUPDATE_HOOK -DSQLITE_ENABLE_RTREE -DSQLITE_ENABLE_SESSION -DSQLITE_ENABLE_STMTVTAB -DSQLITE_ENABLE_UNLOCK_NOTIFY -DSQLITE_ENABLE_UPDATE_DELETE_LIMIT -DSQLITE_SECURE_DELETE -DSQLITE_SOUNDEX -DSQLITE_USE_URI -DSQLITE_MAX_VARIABLE_NUMBER=250000 -DSQLITE_LIKE_DOESNT_MATCH_BLOBS"
RUN ./configure --prefix=/usr --disable-static --disable-readline --disable-tcl --enable-update-limit && make -j2 && make DESTDIR=/stage install
RUN mkdir -p /package/DEBIAN /package/usr/lib/x86_64-linux-gnu /package/usr/share/doc/libsqlite3-0 && cp -a /stage/usr/lib/libsqlite3.so* /package/usr/lib/x86_64-linux-gnu/ && printf 'Package: libsqlite3-0\nVersion: 3.54.1-oci1\nArchitecture: amd64\nMaintainer: Michelangelo OCI maintainers\nSection: libs\nPriority: optional\nDepends: libc6 (>= 2.34)\nDescription: SQLite 3.54.1 shared library with upstream security corrections\n' > /package/DEBIAN/control && head -n 11 sqlite3.h > /package/usr/share/doc/libsqlite3-0/copyright && dpkg-deb --build /package /tmp/libsqlite3-security.deb
