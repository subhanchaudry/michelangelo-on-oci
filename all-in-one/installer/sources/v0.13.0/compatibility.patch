diff --git a/go/components/inferenceserver/clientfactory/factory_test.go b/go/components/inferenceserver/clientfactory/factory_test.go
new file mode 100644
index 0000000..0fb5f84
--- /dev/null
+++ b/go/components/inferenceserver/clientfactory/factory_test.go
@@ -0,0 +1,29 @@
+package clientfactory
+
+import (
+	v2pb "github.com/michelangelo-ai/michelangelo/proto-go/api/v2"
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestCredentialCacheExpires(t *testing.T) {
+	var cache sync.Map
+	cache.Store("cluster", cachedClient{value: "old", expires: time.Now().Add(-time.Second)})
+	if _, ok := freshCached(&cache, "cluster"); ok {
+		t.Fatal("expired credentials were reused")
+	}
+	cache.Store("cluster", cachedClient{value: "new", expires: time.Now().Add(time.Minute)})
+	if value, ok := freshCached(&cache, "cluster"); !ok || value != "new" {
+		t.Fatal("fresh credentials were discarded")
+	}
+}
+
+func TestCacheSeparatesCredentialReferences(t *testing.T) {
+	cluster := &v2pb.ClusterTarget{ClusterId: "pilot", Connection: &v2pb.ClusterTarget_Kubernetes{Kubernetes: &v2pb.ConnectionSpec{Host: "https://cluster", Port: "443", TokenTag: "a", CaDataTag: "ca"}}}
+	first := cacheKey(cluster)
+	cluster.GetKubernetes().TokenTag = "b"
+	if first == cacheKey(cluster) {
+		t.Fatal("different credential references share a client")
+	}
+}
