+
+type queueTestHandler struct {
+	api.Handler
+	kube client.Client
+}
+
+func (h queueTestHandler) Get(ctx context.Context, namespace, name string, opts *metav1.GetOptions, object client.Object) error {
+	return h.kube.Get(ctx, client.ObjectKey{Namespace: namespace, Name: name}, object)
+}
+
+func TestPilotQueueWaitsForTerminalRun(t *testing.T) {
+	t.Setenv("MA_PILOT_WORKFLOW_QUEUE", "true")
+	scheme := runtime.NewScheme()
+	require.NoError(t, coordinationv1.AddToScheme(scheme))
+	require.NoError(t, v2pb.AddToScheme(scheme))
+	first := &v2pb.PipelineRun{ObjectMeta: metav1.ObjectMeta{Name: "first", Namespace: "oci-ranking-showcase", CreationTimestamp: metav1.NewTime(time.Now().Add(-time.Minute))}, Status: v2pb.PipelineRunStatus{State: v2pb.PIPELINE_RUN_STATE_RUNNING}}
+	next := &v2pb.PipelineRun{ObjectMeta: metav1.ObjectMeta{Name: "second", Namespace: "oci-bert-cola-showcase", CreationTimestamp: metav1.Now()}}
+	lease := &coordinationv1.Lease{ObjectMeta: metav1.ObjectMeta{Name: "michelangelo-pilot-workflows", Namespace: "ma-system"}}
+	kube := fake.NewClientBuilder().WithScheme(scheme).WithObjects(first, next, lease).Build()
+	r := &Reconciler{queueClient: kube, Handler: queueTestHandler{kube: kube}}
+	allowed, err := r.reservePilotExecution(context.Background(), first)
+	require.NoError(t, err)
+	require.True(t, allowed)
+	allowed, err = r.reservePilotExecution(context.Background(), next)
+	require.NoError(t, err)
+	require.False(t, allowed)
+	first.Status.State = v2pb.PIPELINE_RUN_STATE_SUCCEEDED
+	require.NoError(t, kube.Update(context.Background(), first))
+	allowed, err = r.reservePilotExecution(context.Background(), next)
+	require.NoError(t, err)
+	require.True(t, allowed)
+}
+
+func TestPilotQueueDoesNotBypassMissingHistory(t *testing.T) {
+	t.Setenv("MA_PILOT_WORKFLOW_QUEUE", "true")
+	scheme := runtime.NewScheme()
+	require.NoError(t, coordinationv1.AddToScheme(scheme))
+	require.NoError(t, v2pb.AddToScheme(scheme))
+	holder := "oci-ranking-showcase/lost"
+	lease := &coordinationv1.Lease{ObjectMeta: metav1.ObjectMeta{Name: "michelangelo-pilot-workflows", Namespace: "ma-system"}, Spec: coordinationv1.LeaseSpec{HolderIdentity: &holder}}
+	kube := fake.NewClientBuilder().WithScheme(scheme).WithObjects(lease).Build()
+	r := &Reconciler{queueClient: kube, Handler: queueTestHandler{kube: kube}}
+	run := &v2pb.PipelineRun{ObjectMeta: metav1.ObjectMeta{Name: "next", Namespace: "oci-ranking-showcase"}}
+	allowed, err := r.reservePilotExecution(context.Background(), run)
+	require.Error(t, err)
+	require.False(t, allowed)
+	run.Spec.Kill = true
+	allowed, err = r.reservePilotExecution(context.Background(), run)
+	require.NoError(t, err)
+	require.True(t, allowed)
+}
+
+func (h queueTestHandler) Update(ctx context.Context, object client.Object, opts *metav1.UpdateOptions) error {
+	return h.kube.Update(ctx, object)
+}
+func TestPilotQueueExpiresThroughNormalKillPath(t *testing.T) {
+	t.Setenv("MA_PILOT_WORKFLOW_QUEUE", "true")
+	scheme := runtime.NewScheme()
+	require.NoError(t, coordinationv1.AddToScheme(scheme))
+	require.NoError(t, v2pb.AddToScheme(scheme))
+	run := &v2pb.PipelineRun{ObjectMeta: metav1.ObjectMeta{Name: "expired", Namespace: "oci-ranking-showcase"}, Status: v2pb.PipelineRunStatus{State: v2pb.PIPELINE_RUN_STATE_RUNNING}}
+	holder := run.Namespace + "/" + run.Name
+	started := metav1.NewMicroTime(time.Now().Add(-31 * time.Minute))
+	lease := &coordinationv1.Lease{ObjectMeta: metav1.ObjectMeta{Name: "michelangelo-pilot-workflows", Namespace: "ma-system"}, Spec: coordinationv1.LeaseSpec{HolderIdentity: &holder, RenewTime: &started}}
+	kube := fake.NewClientBuilder().WithScheme(scheme).WithObjects(run, lease).Build()
+	r := &Reconciler{queueClient: kube, Handler: queueTestHandler{kube: kube}}
+	allowed, err := r.reservePilotExecution(context.Background(), run)
+	require.NoError(t, err)
+	require.True(t, allowed)
+	require.True(t, run.Spec.Kill)
+	require.Equal(t, "30-minute execution limit exceeded", run.Annotations["michelangelo.ai/pilot-stop-reason"])
+}
+
+func TestPilotQueueHonorsOldestRunAcrossProjects(t *testing.T) {
+	t.Setenv("MA_PILOT_WORKFLOW_QUEUE", "true")
+	scheme := runtime.NewScheme()
+	require.NoError(t, coordinationv1.AddToScheme(scheme))
+	require.NoError(t, v2pb.AddToScheme(scheme))
+	older := &v2pb.PipelineRun{ObjectMeta: metav1.ObjectMeta{Name: "older", Namespace: "oci-ranking-showcase", CreationTimestamp: metav1.NewTime(time.Now().Add(-time.Minute))}}
+	newer := &v2pb.PipelineRun{ObjectMeta: metav1.ObjectMeta{Name: "newer", Namespace: "oci-bert-cola-showcase", CreationTimestamp: metav1.Now()}}
