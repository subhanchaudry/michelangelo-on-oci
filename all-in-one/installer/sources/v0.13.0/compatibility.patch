diff --git a/helm/michelangelo/files/studio-auth.py b/helm/michelangelo/files/studio-auth.py
new file mode 100644
index 0000000..2324bde
--- /dev/null
+++ b/helm/michelangelo/files/studio-auth.py
@@ -0,0 +1,59 @@
+"""Private operator login; no external identity provider or user database."""
+import base64,hashlib,hmac,json,secrets,time,threading
+from http.server import BaseHTTPRequestHandler,ThreadingHTTPServer
+from http.cookies import SimpleCookie
+from pathlib import Path
+from urllib.parse import parse_qs
+CONFIG=Path('/auth/config.json')
+COOKIE='ma_pilot_session'
+LOCK=threading.Lock();ATTEMPTS=[]
+def config():return json.loads(CONFIG.read_text())
+def sign(value,key):return hmac.new(key.encode(),value.encode(),hashlib.sha256).hexdigest()
+def password_ok(username,password,c):
+ actual=hashlib.pbkdf2_hmac('sha256',password.encode(),bytes.fromhex(c['salt']),600000).hex()
+ return hmac.compare_digest(username,c['username']) and hmac.compare_digest(actual,c['password_hash'])
+def authorized(headers,c):
+ try:
+  cookie=SimpleCookie();cookie.load(headers.get('Cookie',''));token=cookie[COOKIE].value
+  expiry,nonce,signature=token.split('.');value=expiry+'.'+nonce
+  return time.time()<int(expiry)<=time.time()+28800 and hmac.compare_digest(signature,sign(value,c['session_key']))
+ except (KeyError,ValueError):return False
+PAGE='''<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sign in to Michelangelo Studio</title><style>body{font:16px system-ui;background:#f4f6fb;color:#172138;margin:0;display:grid;min-height:100vh;place-items:center}main{background:white;padding:36px;border-radius:16px;width:min(360px,80vw);box-shadow:0 8px 40px #12234412}h1{font-size:26px}label{display:block;margin-top:18px}input,button{box-sizing:border-box;width:100%;padding:12px;font:inherit;margin-top:8px;border:1px solid #9aa7bd;border-radius:6px}button{background:#245edb;color:white;border:0;margin-top:24px}p{color:#536078;line-height:1.5}</style></head><body><main><h1>Michelangelo Studio</h1><p>Private internal operator pilot</p>MESSAGE<form method="post" action="/login"><label for="username">Username</label><input id="username" name="username" autocomplete="username" required><label for="password">Password</label><input id="password" name="password" type="password" autocomplete="current-password" required><button type="submit">Sign in</button></form></main></body></html>'''
+class Handler(BaseHTTPRequestHandler):
+ def log_message(self,*args):pass
+ def reply(self,status,body=b'',headers=None):
+  self.send_response(status)
+  self.send_header('Cache-Control','no-store');self.send_header('X-Content-Type-Options','nosniff')
+  self.send_header('Content-Security-Policy',"default-src 'none'; style-src 'unsafe-inline'; form-action 'self'; frame-ancestors 'none'")
+  for k,v in (headers or {}).items():self.send_header(k,v)
+  self.send_header('Content-Length',str(len(body)));self.end_headers();self.wfile.write(body)
+ def do_GET(self):
+  c=config()
+  if self.path=='/check':
+   valid=authorized(self.headers,c)
+   if not valid and self.headers.get('Authorization','').startswith('Basic '):
+    try:
+     username,password=base64.b64decode(self.headers['Authorization'][6:],validate=True).decode().split(':',1);valid=password_ok(username,password,c)
+    except (ValueError,UnicodeError):pass
+   self.reply(204 if valid else 401);return
+  if self.path=='/login':self.reply(200,PAGE.replace('MESSAGE','').encode(),{'Content-Type':'text/html; charset=utf-8'});return
+  self.reply(404)
+ def do_POST(self):
+  if self.path=='/logout':
+   self.reply(303,headers={'Location':'/login','Set-Cookie':COOKIE+'=; Path=/; HttpOnly; SameSite=Strict; Max-Age=0'});return
+  if self.path!='/login':self.reply(404);return
+  origin=self.headers.get('Origin');host=self.headers.get('X-Forwarded-Host',self.headers.get('Host',''))
+  if origin and origin not in ('http://'+host,'https://'+host):self.reply(403);return
+  try:length=int(self.headers.get('Content-Length','0'))
+  except ValueError:self.reply(400);return
+  if not 0<length<=4096:self.reply(400);return
+  with LOCK:
+   ATTEMPTS[:]=[t for t in ATTEMPTS if time.time()-t<60]
+   if len(ATTEMPTS)>=20:self.reply(429,b'Too many attempts. Please wait one minute.');return
+   ATTEMPTS.append(time.time())
+  fields=parse_qs(self.rfile.read(length).decode());c=config()
+  if not password_ok(fields.get('username',[''])[0],fields.get('password',[''])[0],c):
+   self.reply(401,PAGE.replace('MESSAGE','<p role="alert">Username or password is incorrect.</p>').encode(),{'Content-Type':'text/html; charset=utf-8'});return
+  value=str(int(time.time())+28800)+'.'+secrets.token_hex(16);token=value+'.'+sign(value,c['session_key'])
+  self.reply(303,headers={'Location':'/','Set-Cookie':COOKIE+'='+token+'; Path=/; HttpOnly; SameSite=Strict; Max-Age=28800'})
+if __name__=='__main__':ThreadingHTTPServer(('127.0.0.1',8085),Handler).serve_forever()
