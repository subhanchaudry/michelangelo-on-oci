diff --git a/go/worker/activities/deployment/deployment_activities_test.go b/go/worker/activities/deployment/deployment_activities_test.go
new file mode 100644
index 0000000..8da8f3c
--- /dev/null
+++ b/go/worker/activities/deployment/deployment_activities_test.go
@@ -0,0 +1,62 @@
+package deployment
+
+import (
+	"context"
+	"testing"
+
+	"github.com/cadence-workflow/starlark-worker/service"
+	"github.com/cadence-workflow/starlark-worker/test/types"
+	"github.com/michelangelo-ai/michelangelo/proto-go/api"
+	v2pb "github.com/michelangelo-ai/michelangelo/proto-go/api/v2"
+	"github.com/stretchr/testify/require"
+	"go.uber.org/yarpc"
+)
+
+type deploymentClient struct {
+	v2pb.DeploymentServiceYARPCClient
+	deployment *v2pb.Deployment
+}
+
+func (c *deploymentClient) GetDeployment(context.Context, *v2pb.GetDeploymentRequest, ...yarpc.CallOption) (*v2pb.GetDeploymentResponse, error) {
+	return &v2pb.GetDeploymentResponse{Deployment: c.deployment}, nil
+}
+func TestSensorRevisionReadiness(t *testing.T) {
+	for _, engine := range []struct {
+		name     string
+		newSuite func() types.StarTestActivitySuite
+	}{
+		{"cadence", service.NewCadTestActivitySuite}, {"temporal", service.NewTempTestActivitySuite},
+	} {
+		t.Run(engine.name, func(t *testing.T) {
+			for _, tc := range []struct {
+				name, desired, current, expected string
+				stage                            v2pb.DeploymentStage
+				errorText                        string
+			}{
+				{"old completed rollout", "B", "A", "B", v2pb.DEPLOYMENT_STAGE_ROLLOUT_COMPLETE, "failed-precondition"},
+				{"no current revision", "B", "", "B", v2pb.DEPLOYMENT_STAGE_ROLLOUT_COMPLETE, "failed-precondition"},
+				{"requested revision ready", "B", "B", "B", v2pb.DEPLOYMENT_STAGE_ROLLOUT_COMPLETE, ""},
+				{"concurrent update", "C", "A", "B", v2pb.DEPLOYMENT_STAGE_ROLLOUT_COMPLETE, "invalid-argument"},
+				{"failure preserved", "B", "A", "B", v2pb.DEPLOYMENT_STAGE_ROLLOUT_FAILED, ""},
+				{"rollback terminal preserved", "B", "A", "B", v2pb.DEPLOYMENT_STAGE_ROLLBACK_COMPLETE, ""},
+				{"legacy no expectation", "B", "A", "", v2pb.DEPLOYMENT_STAGE_ROLLOUT_COMPLETE, ""},
+			} {
+				t.Run(tc.name, func(t *testing.T) {
+					d := &v2pb.Deployment{Spec: v2pb.DeploymentSpec{DesiredRevision: &api.ResourceIdentifier{Name: tc.desired}}, Status: v2pb.DeploymentStatus{Stage: tc.stage, CurrentRevision: &api.ResourceIdentifier{Name: tc.current}}}
+					a := &activities{deploymentService: &deploymentClient{deployment: d}}
+					s := engine.newSuite()
+					s.RegisterActivity(a)
+					result, err := s.ExecuteActivity(Activities.SensorDeployment, SensorDeploymentRequest{Namespace: "test", DeploymentName: "endpoint", ExpectedModelRevision: tc.expected})
+					if tc.errorText != "" {
+						require.ErrorContains(t, err, tc.errorText)
+						return
+					}
+					require.NoError(t, err)
+					var actual v2pb.Deployment
+					require.NoError(t, result.Get(&actual))
+					require.Equal(t, tc.current, actual.Status.CurrentRevision.Name)
+				})
+			}
+		})
+	}
+}
