+func TestPrivateCPUConfiguration(t *testing.T) {
+	pinned := "registry.example/runtime@sha256:" + strings.Repeat("a", 64)
+	t.Setenv("MA_PILOT_NODE_SELECTOR", `{"customer.example/pool":"cpu"}`)
+	t.Setenv("MA_PILOT_NODE_TOLERATIONS", `[{"key":"customer.example/pool","operator":"Equal","value":"cpu","effect":"NoSchedule"}]`)
+	t.Setenv("MA_MODEL_DELIVERY_IMAGE", pinned)
+	t.Setenv("MA_MODEL_STORAGE_SECRET", "scoped-artifacts")
+	t.Setenv("MA_MODEL_STORAGE_CONFIG", "scoped-artifacts")
+	deployment := &appsv1.Deployment{}
+	deployment.Spec.Template.Spec.Containers = []corev1.Container{{Name: "triton", Image: pinned}}
+	deployment.Spec.Template.Spec.Volumes = []corev1.Volume{{Name: "workdir", VolumeSource: corev1.VolumeSource{HostPath: &corev1.HostPathVolumeSource{Path: "/bad"}}}}
+	if err := configurePrivateCPU(deployment); err != nil {
+		t.Fatal(err)
+	}
+	pod := deployment.Spec.Template.Spec
+	require.Equal(t, map[string]string{"customer.example/pool": "cpu"}, pod.NodeSelector)
+	require.Equal(t, "customer.example/pool", pod.Tolerations[0].Key)
+	if pod.Volumes[0].HostPath != nil || pod.Volumes[0].EmptyDir == nil {
+		t.Fatal("model storage must be pod local")
+	}
+	if *pod.AutomountServiceAccountToken || !*pod.SecurityContext.RunAsNonRoot {
+		t.Fatal("unexpected runtime authority")
+	}
+	if len(pod.Containers) != 2 || len(pod.Containers[0].EnvFrom) != 0 || len(pod.Containers[1].EnvFrom) != 2 {
+		t.Fatal("storage credentials must be delivery-only")
+	}
+	if pod.Containers[0].ReadinessProbe.HTTPGet.Path != "/v2/health/ready" {
+		t.Fatal("missing Triton readiness probe")
+	}
+	if pod.Containers[0].Resources.Limits.Cpu().String() != "2" {
+		t.Fatal("CPU must be bounded")
+	}
+	deployment.Spec.Template.Spec.Containers[0].Image = "registry.example/runtime:latest"
+	if configurePrivateCPU(deployment) == nil {
+		t.Fatal("mutable image accepted")
+	}
+	deployment.Spec.Template.Spec.Containers[0].Image = pinned
+	t.Setenv("MA_PILOT_NODE_SELECTOR", `{}`)
+	require.Error(t, configurePrivateCPU(deployment), "unconstrained placement must be rejected")
+}
+
+func TestReactivationReconcilesZeroReplicas(t *testing.T) {
+	pinned := "registry.example/runtime@sha256:" + strings.Repeat("b", 64)
