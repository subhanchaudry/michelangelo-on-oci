index 0000000..3066427
--- /dev/null
+++ b/go/components/inferenceserver/plugins/oss/suspension.go
@@ -0,0 +1,61 @@
+package oss
+
+import (
+	"context"
+	"fmt"
+	v2pb "github.com/michelangelo-ai/michelangelo/proto-go/api/v2"
+	appsv1 "k8s.io/api/apps/v1"
+	corev1 "k8s.io/api/core/v1"
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+)
+
+// ReconcileSuspension preserves model configuration and Service identity while
+// releasing pods. The retained ConfigMap restores the selected models on resume.
+func (p *Plugin) ReconcileSuspension(ctx context.Context, server *v2pb.InferenceServer) (bool, error) {
+	if !server.Spec.GetSuspended() {
+		return false, nil
+	}
+	state := v2pb.INFERENCE_SERVER_STATE_SUSPENDED
+	statuses := make([]*v2pb.ClusterTargetStatus, 0, len(server.Spec.ClusterTargets))
+	for _, target := range server.Spec.ClusterTargets {
+		kube, err := p.clientFactory.GetClient(ctx, target)
+		if err != nil {
+			return true, err
+		}
+		deployment := &appsv1.Deployment{}
+		err = kube.Get(ctx, client.ObjectKey{Namespace: server.Namespace, Name: "triton-" + server.Name}, deployment)
+		clusterState := v2pb.INFERENCE_SERVER_STATE_SUSPENDED
+		if err != nil && !apierrors.IsNotFound(err) {
+			return true, err
+		}
+		if err == nil {
+			if deployment.Spec.Replicas == nil || *deployment.Spec.Replicas != 0 {
+				zero := int32(0)
+				deployment.Spec.Replicas = &zero
+				if err = kube.Update(ctx, deployment); err != nil {
+					return true, fmt.Errorf("suspend target %s: %w", target.ClusterId, err)
+				}
+				clusterState = v2pb.INFERENCE_SERVER_STATE_SUSPENDING
+			}
+			if deployment.Status.Replicas != 0 || deployment.Status.ObservedGeneration < deployment.Generation {
+				clusterState = v2pb.INFERENCE_SERVER_STATE_SUSPENDING
+			}
+		}
+		pods := &corev1.PodList{}
+		if err := kube.List(ctx, pods, client.InNamespace(server.Namespace), client.MatchingLabels{"app": "triton-" + server.Name}); err != nil {
+			return true, err
+		}
+		if len(pods.Items) > 0 {
+			clusterState = v2pb.INFERENCE_SERVER_STATE_SUSPENDING
+		}
+		if clusterState == v2pb.INFERENCE_SERVER_STATE_SUSPENDING {
+			state = clusterState
+		}
+		statuses = append(statuses, &v2pb.ClusterTargetStatus{ClusterId: target.ClusterId, State: clusterState, Message: "Operator requested compute suspension"})
+	}
+	server.Status.State = state
+	server.Status.ClusterStatuses = statuses
+	server.Status.Conditions = nil
+	return true, nil
+}
