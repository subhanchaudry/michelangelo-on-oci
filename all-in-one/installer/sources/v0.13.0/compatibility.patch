+package backends
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"regexp"
+	"strings"
+	"time"
+
+	appsv1 "k8s.io/api/apps/v1"
+	coordinationv1 "k8s.io/api/coordination/v1"
+	corev1 "k8s.io/api/core/v1"
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	"k8s.io/apimachinery/pkg/api/resource"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/util/intstr"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+)
+
+var digestImage = regexp.MustCompile(`^[^\s@]+@sha256:[0-9a-f]{64}$`)
+
+// configurePrivateCPU requires explicit, pinned runtime images and scopes artifact
+// credentials to the delivery container. It never mounts host model directories.
+func configurePrivateCPU(deployment *appsv1.Deployment) error {
+	image, delivery := deployment.Spec.Template.Spec.Containers[0].Image, os.Getenv("MA_MODEL_DELIVERY_IMAGE")
+	if !digestImage.MatchString(image) || !digestImage.MatchString(delivery) {
+		return fmt.Errorf("servingSpec.image (or configured Triton default) and MA_MODEL_DELIVERY_IMAGE must be digest pinned")
+	}
+	secret, config := os.Getenv("MA_MODEL_STORAGE_SECRET"), os.Getenv("MA_MODEL_STORAGE_CONFIG")
+	if secret == "" || config == "" {
+		return fmt.Errorf("scoped model storage Secret and ConfigMap are required")
+	}
+	var selector map[string]string
+	var tolerations []corev1.Toleration
+	if err := json.Unmarshal([]byte(os.Getenv("MA_PILOT_NODE_SELECTOR")), &selector); err != nil || len(selector) == 0 {
+		return fmt.Errorf("MA_PILOT_NODE_SELECTOR must specify approved CPU node labels as a nonempty JSON object")
+	}
+	if err := json.Unmarshal([]byte(os.Getenv("MA_PILOT_NODE_TOLERATIONS")), &tolerations); err != nil {
+		return fmt.Errorf("MA_PILOT_NODE_TOLERATIONS must be a JSON array: %w", err)
+	}
+	pod := &deployment.Spec.Template.Spec
+	no, yes, uid := false, true, int64(65532)
+	pod.AutomountServiceAccountToken = &no
+	pod.ServiceAccountName = "michelangelo-inference"
+	pod.NodeSelector = selector
+	pod.Tolerations = tolerations
+	pod.SecurityContext = &corev1.PodSecurityContext{RunAsNonRoot: &yes, RunAsUser: &uid, RunAsGroup: &uid, FSGroup: &uid, SeccompProfile: &corev1.SeccompProfile{Type: corev1.SeccompProfileTypeRuntimeDefault}}
+	security := &corev1.SecurityContext{AllowPrivilegeEscalation: &no, Capabilities: &corev1.Capabilities{Drop: []corev1.Capability{"ALL"}}}
+	container := &pod.Containers[0]
+	container.Image = image
+	container.SecurityContext = security
+	sharedMemory := resource.MustParse("128Mi")
+	pod.Volumes = append(pod.Volumes, corev1.Volume{Name: "python-shm", VolumeSource: corev1.VolumeSource{EmptyDir: &corev1.EmptyDirVolumeSource{Medium: corev1.StorageMediumMemory, SizeLimit: &sharedMemory}}})
+	container.VolumeMounts = append(container.VolumeMounts, corev1.VolumeMount{Name: "python-shm", MountPath: "/dev/shm"})
+	container.Resources = corev1.ResourceRequirements{
+		Requests: corev1.ResourceList{corev1.ResourceCPU: resource.MustParse("1"), corev1.ResourceMemory: resource.MustParse("2Gi"), corev1.ResourceEphemeralStorage: resource.MustParse("2Gi")},
+		Limits:   corev1.ResourceList{corev1.ResourceCPU: resource.MustParse("2"), corev1.ResourceMemory: resource.MustParse("5Gi"), corev1.ResourceEphemeralStorage: resource.MustParse("6Gi")},
+	}
+	container.ReadinessProbe = &corev1.Probe{ProbeHandler: corev1.ProbeHandler{HTTPGet: &corev1.HTTPGetAction{Path: "/v2/health/ready", Port: intstr.FromInt32(8000)}}, PeriodSeconds: 5, TimeoutSeconds: 2, FailureThreshold: 3}
+	for i := range pod.Volumes {
+		if pod.Volumes[i].Name == "workdir" {
+			size := resource.MustParse("4Gi")
+			pod.Volumes[i].VolumeSource = corev1.VolumeSource{EmptyDir: &corev1.EmptyDirVolumeSource{SizeLimit: &size}}
+		}
+	}
+	pod.Containers = append(pod.Containers, corev1.Container{
+		Name: "model-delivery", Image: delivery, Command: []string{"python3", "/opt/michelangelo/delivery.py"}, SecurityContext: security,
+		EnvFrom:      []corev1.EnvFromSource{{ConfigMapRef: &corev1.ConfigMapEnvSource{LocalObjectReference: corev1.LocalObjectReference{Name: config}}}, {SecretRef: &corev1.SecretEnvSource{LocalObjectReference: corev1.LocalObjectReference{Name: secret}}}},
+		VolumeMounts: []corev1.VolumeMount{{Name: "workdir", MountPath: "/mnt/models"}, {Name: "model-config", MountPath: "/etc/michelangelo/models", ReadOnly: true}},
+		Resources:    corev1.ResourceRequirements{Requests: corev1.ResourceList{corev1.ResourceCPU: resource.MustParse("100m"), corev1.ResourceMemory: resource.MustParse("128Mi")}, Limits: corev1.ResourceList{corev1.ResourceCPU: resource.MustParse("500m"), corev1.ResourceMemory: resource.MustParse("512Mi")}},
+	})
+	deployment.Spec.Strategy = appsv1.DeploymentStrategy{Type: appsv1.RecreateDeploymentStrategyType}
+	return nil
+}
+
+// acquirePilotSlot serializes native endpoint activation through one pre-created
+// Kubernetes Lease. A different target can take over only after compute is gone.
+func acquirePilotSlot(ctx context.Context, kube client.Client, namespace, name string) error {
+	lease := &coordinationv1.Lease{}
+	key := client.ObjectKey{Namespace: "ma-system", Name: "michelangelo-pilot-serving"}
+	if err := kube.Get(ctx, key, lease); err != nil {
+		return fmt.Errorf("read pilot serving lease: %w", err)
+	}
+	identity := namespace + "/" + name
+	if lease.Spec.HolderIdentity != nil && *lease.Spec.HolderIdentity == identity {
+		return nil
+	}
+	if lease.Spec.HolderIdentity != nil && *lease.Spec.HolderIdentity != "" {
+		if lease.Spec.RenewTime == nil || time.Since(lease.Spec.RenewTime.Time) < 2*time.Minute {
+			return fmt.Errorf("another endpoint activation owns the pilot serving slot")
+		}
+		parts := strings.Split(*lease.Spec.HolderIdentity, "/")
+		if len(parts) != 2 {
+			return fmt.Errorf("invalid pilot serving lease holder")
+		}
+		previous := &appsv1.Deployment{}
+		err := kube.Get(ctx, client.ObjectKey{Namespace: parts[0], Name: "triton-" + parts[1]}, previous)
+		if err != nil && !apierrors.IsNotFound(err) {
+			return err
+		}
+		if err == nil && (previous.Spec.Replicas == nil || *previous.Spec.Replicas != 0) {
+			return fmt.Errorf("deactivate %s before activating another endpoint", *lease.Spec.HolderIdentity)
+		}
+		pods := &corev1.PodList{}
+		if err := kube.List(ctx, pods, client.InNamespace(parts[0]), client.MatchingLabels{"app": "triton-" + parts[1]}); err != nil {
+			return err
+		}
+		if len(pods.Items) > 0 {
+			return fmt.Errorf("previous endpoint still has compute allocated")
+		}
+	}
+	now := metav1.NewMicroTime(time.Now())
+	lease.Spec.HolderIdentity = &identity
+	lease.Spec.RenewTime = &now
+	if err := kube.Update(ctx, lease); err != nil {
+		return fmt.Errorf("acquire pilot serving slot: %w", err)
+	}
+	return nil
+}
