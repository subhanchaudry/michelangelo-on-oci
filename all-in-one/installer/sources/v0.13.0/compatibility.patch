diff --git a/python/michelangelo/uniflow/core/lib/tests/deployment_test.py b/python/michelangelo/uniflow/core/lib/tests/deployment_test.py
new file mode 100644
index 0000000..f53c70a
--- /dev/null
+++ b/python/michelangelo/uniflow/core/lib/tests/deployment_test.py
@@ -0,0 +1,40 @@
+"""Regression tests for a new desired revision with the old completed status."""
+import unittest
+from unittest.mock import patch
+from michelangelo.uniflow.core.lib import deployment as lib
+from michelangelo.gen.api.v2.deployment_pb2 import Deployment, DeploymentStage
+
+
+def resource(current, desired="B", stage=DeploymentStage.DEPLOYMENT_STAGE_ROLLOUT_COMPLETE):
+    d = Deployment()
+    d.spec.desired_revision.name = desired
+    d.status.current_revision.name = current
+    d.status.stage = stage
+    return d
+
+
+class DeploymentReadinessTest(unittest.TestCase):
+    def test_waits_for_new_revision(self):
+        with patch.object(lib.APIClient.DeploymentService, "get_deployment", side_effect=[resource("A"), resource("B")]) as get, patch.object(lib.time, "sleep") as sleep:
+            result = lib.wait_for_deployment("test", "endpoint", "B", timeout=10, poll=1)
+        self.assertEqual(result["current_revision"], "B")
+        self.assertEqual(get.call_count, 2)
+        sleep.assert_called_once_with(1)
+
+    def test_stale_success_times_out(self):
+        with patch.object(lib.APIClient.DeploymentService, "get_deployment", return_value=resource("A")):
+            with self.assertRaisesRegex(RuntimeError, "timeout waiting"):
+                lib.wait_for_deployment("test", "endpoint", "B", timeout=0)
+
+    def test_concurrent_change_rejected(self):
+        with patch.object(lib.APIClient.DeploymentService, "get_deployment", return_value=resource("A", desired="C")):
+            with self.assertRaisesRegex(RuntimeError, "updated by another workflow"):
+                lib.wait_for_deployment("test", "endpoint", "B")
+
+    def test_failure_preserved(self):
+        with patch.object(lib.APIClient.DeploymentService, "get_deployment", return_value=resource("A", stage=DeploymentStage.DEPLOYMENT_STAGE_ROLLOUT_FAILED)):
+            with self.assertRaisesRegex(RuntimeError, "deployment failed"):
+                lib.wait_for_deployment("test", "endpoint", "B")
+
+if __name__ == "__main__":
+    unittest.main()
