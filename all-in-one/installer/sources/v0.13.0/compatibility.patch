new file mode 100644
index 0000000..b5c6d7e
--- /dev/null
+++ b/go/components/pipelinerun/pilot_queue.go
@@ -0,0 +1,88 @@
+package pipelinerun
+
+import (
+	"context"
+	"fmt"
+	v2pb "github.com/michelangelo-ai/michelangelo/proto-go/api/v2"
+	coordinationv1 "k8s.io/api/coordination/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"os"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+	"strings"
+	"time"
+)
+
+// reservePilotExecution queues workflows before they allocate Ray/Spark compute.
+// A slot is released only after the previous native run is terminal. A missing
+// record fails closed: an operator must investigate rather than duplicate work.
+func (r *Reconciler) reservePilotExecution(ctx context.Context, run *v2pb.PipelineRun) (bool, error) {
+	if os.Getenv("MA_PILOT_WORKFLOW_QUEUE") != "true" || isTerminalState(run.Status.State) || run.Spec.GetKill() {
+		return true, nil
+	}
+	switch run.Namespace {
+	case "oci-ranking-showcase", "oci-movielens-showcase", "oci-fraud-anomaly-showcase", "oci-california-housing-showcase", "oci-bert-cola-showcase":
+	default:
+		return true, nil
+	}
+	if r.queueClient == nil {
+		return false, fmt.Errorf("pilot workflow queue is not configured")
+	}
+	lease := &coordinationv1.Lease{}
+	if err := r.queueClient.Get(ctx, client.ObjectKey{Namespace: "ma-system", Name: "michelangelo-pilot-workflows"}, lease); err != nil {
+		return false, err
+	}
+	identity := run.Namespace + "/" + run.Name
+	if lease.Spec.HolderIdentity != nil && *lease.Spec.HolderIdentity == identity {
+		// Bound each admitted pilot execution, including cluster startup and
+		// external artifact waits. Use the normal kill path so cleanup runs.
+		if lease.Spec.RenewTime != nil && time.Since(lease.Spec.RenewTime.Time) > 30*time.Minute {
+			run.Spec.Kill = true
+			if run.Annotations == nil {
+				run.Annotations = map[string]string{}
+			}
+			run.Annotations["michelangelo.ai/pilot-stop-reason"] = "30-minute execution limit exceeded"
+			if err := r.Update(ctx, run, &metav1.UpdateOptions{}); err != nil {
+				return false, err
+			}
+		}
+		return true, nil
+	}
+	if lease.Spec.HolderIdentity != nil && *lease.Spec.HolderIdentity != "" {
+		parts := strings.Split(*lease.Spec.HolderIdentity, "/")
+		if len(parts) != 2 {
+			return false, fmt.Errorf("invalid workflow queue holder")
+		}
+		previous := &v2pb.PipelineRun{}
+		if err := r.Get(ctx, parts[0], parts[1], &metav1.GetOptions{}, previous); err != nil {
+			return false, fmt.Errorf("verify previous queued run: %w", err)
+		}
+		if !isTerminalState(previous.Status.State) {
+			return false, nil
+		}
+	}
+	// Admit the oldest waiting run across the five pilot projects. Reconcile
+	// order is not a queue: without this check a new run can starve older work.
+	for _, namespace := range []string{"oci-ranking-showcase", "oci-movielens-showcase", "oci-fraud-anomaly-showcase", "oci-california-housing-showcase", "oci-bert-cola-showcase"} {
+		waiting := &v2pb.PipelineRunList{}
+		if err := r.queueClient.List(ctx, waiting, client.InNamespace(namespace)); err != nil {
+			return false, fmt.Errorf("inspect pilot queue: %w", err)
+		}
+		for _, candidate := range waiting.Items {
+			if isTerminalState(candidate.Status.State) || candidate.Spec.GetKill() || candidate.DeletionTimestamp != nil {
+				continue
+			}
+			candidateID := candidate.Namespace + "/" + candidate.Name
+			if candidateID == identity { continue }
+			if candidate.CreationTimestamp.Before(&run.CreationTimestamp) || (candidate.CreationTimestamp.Equal(&run.CreationTimestamp) && candidateID < identity) {
+				return false, nil
+			}
+		}
+	}
+	now := metav1.NewMicroTime(time.Now())
+	lease.Spec.HolderIdentity = &identity
+	lease.Spec.RenewTime = &now
+	if err := r.queueClient.Update(ctx, lease); err != nil {
+		return false, err
+	}
+	return true, nil
+}
