@@ -0,0 +1,109 @@
+import { useFormState } from 'react-final-form';
+import { SelectField } from '#core/components/form/fields/select/select-field';
+import { StringField } from '#core/components/form/fields/string/string-field';
+import { required } from '#core/components/form/validation/validators';
+import { FormGroup } from '#core/components/form/layout/form-group/form-group';
+import { useStudioParams } from '#core/hooks/routing/use-studio-params/use-studio-params';
+import { useStudioQuery } from '#core/hooks/use-studio-query';
+type ProjectModelListResult = {
+  modelList: {
+    items: Array<{
+      metadata: {
+        name: string;
+        namespace: string;
+        annotations?: Record<string, string>;
+        labels?: Record<string, string>;
+      };
+    }>;
+  };
+};
+
+/** Values use the existing PipelineRun.spec.input.kw_args workflow contract. */
+export const LifecycleRunFields = ({ operation }: { operation: string }) => {
+  const { values } = useFormState({ subscription: { values: true } });
+  const deactivating =
+    operation === 'serving' && values.spec?.input?.kw_args?.serving_action === 'deactivate';
+  const { projectId } = useStudioParams('base');
+  const { data, isLoading } = useStudioQuery<ProjectModelListResult>({
+    queryName: 'ListModel',
+    serviceOptions: { namespace: projectId },
+  });
+  const models = (data?.modelList.items ?? [])
+    .filter(
+      (model) =>
+        model.metadata.namespace === projectId &&
+        model.metadata.labels?.['michelangelo.ai/eligible'] === 'true' &&
+        model.metadata.labels?.['michelangelo.ai/negative-test-fixture'] !== 'true' &&
+        model.metadata.annotations?.['michelangelo.ai/demo'] ===
+          values.spec?.pipeline?.name?.replace(/-(batch-predict|serving|experiment|retrain)$/, '')
+    )
+    .map((model) => ({ id: model.metadata.name, label: model.metadata.name }));
+  return (
+    <FormGroup title="Lifecycle inputs">
+      <SelectField
+        name="spec.input.kw_args.model_revision"
+        label={
+          operation === 'retrain' || operation === 'experiment'
+            ? 'Baseline model revision'
+            : 'Model revision'
+        }
+        options={models}
+        isLoading={isLoading}
+        required={!deactivating}
+        validate={deactivating ? undefined : required()}
+        clearable={false}
+        caption="Select an eligible revision for this demo in the current project."
+      />
+      {operation === 'serving' && (
+        <SelectField
+          name="spec.input.kw_args.serving_action"
+          label="Operator action"
+          required
+          validate={required()}
+          clearable={false}
+          options={[
+            { id: 'deploy', label: 'Deploy selected revision' },
+            { id: 'rollback', label: 'Roll back to selected revision' },
+            { id: 'deactivate', label: 'Deactivate target and release compute' },
+          ]}
+        />
+      )}
+      {!deactivating && (
+        <>
+          <StringField
+            name="spec.input.kw_args.dataset_ref"
+            label="Versioned dataset URI"
+            required
+            validate={required()}
+          />
+          <StringField
+            name="spec.input.kw_args.dataset_sha256"
+            label="Dataset SHA-256"
+            required
+            validate={(value: string) =>
+              /^[0-9a-f]{64}$/.test(value ?? '') ? undefined : 'Enter the dataset SHA-256 checksum'
+            }
+          />
+        </>
+      )}
+      {operation === 'experiment' && (
+        <StringField
+          name="spec.input.kw_args.experiment_settings"
+          label="Experiment configurations (JSON)"
+          validate={(value: string) => {
+            try {
+              const configurations: unknown = JSON.parse(value);
+              return Array.isArray(configurations) && configurations.length === 2
+                ? undefined
+                : 'Provide exactly two configurations';
+            } catch {
+              return 'Enter valid JSON';
+            }
+          }}
+          required
+          caption="Provide two bounded configurations evaluated on the same dataset."
+        />
+      )}
+    </FormGroup>
+  );
+};
