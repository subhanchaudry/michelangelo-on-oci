{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "gateway.envoyproxy.io/v1alpha1",
      "kind": "EnvoyProxy",
      "metadata": {
        "name": "ma-private-pilot",
        "namespace": "ma-lifecycle-gateway"
      },
      "spec": {
        "provider": {
          "type": "Kubernetes",
          "kubernetes": {
            "envoyService": {
              "name": "ma-pilot-inference",
              "type": "ClusterIP"
            },
            "envoyDeployment": {
              "replicas": 1,
              "pod": {
                "nodeSelector": {
                  "workload.oci.oracle.com/pool": "cpu"
                },
                "tolerations": [
                  {
                    "key": "workload.oci.oracle.com/pool",
                    "operator": "Equal",
                    "value": "cpu",
                    "effect": "NoSchedule"
                  }
                ]
              },
              "container": {
                "image": "REPLACE_GATEWAY_IMAGE_DIGEST_URI",
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "256Mi"
                  }
                },
                "securityContext": {
                  "runAsNonRoot": true,
                  "runAsUser": 65532,
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "seccompProfile": {
                    "type": "RuntimeDefault"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "apiVersion": "gateway.networking.k8s.io/v1",
      "kind": "GatewayClass",
      "metadata": {
        "name": "ma-private-pilot"
      },
      "spec": {
        "controllerName": "gateway.envoyproxy.io/michelangelo-pilot",
        "parametersRef": {
          "group": "gateway.envoyproxy.io",
          "kind": "EnvoyProxy",
          "name": "ma-private-pilot",
          "namespace": "ma-lifecycle-gateway"
        }
      }
    },
    {
      "apiVersion": "gateway.networking.k8s.io/v1",
      "kind": "Gateway",
      "metadata": {
        "name": "ma-private-pilot",
        "namespace": "ma-lifecycle-gateway"
      },
      "spec": {
        "gatewayClassName": "ma-private-pilot",
        "listeners": [
          {
            "name": "http",
            "protocol": "HTTP",
            "port": 8080,
            "allowedRoutes": {
              "namespaces": {
                "from": "Selector",
                "selector": {
                  "matchExpressions": [
                    {
                      "key": "kubernetes.io/metadata.name",
                      "operator": "In",
                      "values": [
                        "oci-bert-cola-showcase",
                        "oci-california-housing-showcase",
                        "oci-fraud-anomaly-showcase",
                        "oci-movielens-showcase",
                        "oci-ranking-showcase"
                      ]
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    }
  ]
}
