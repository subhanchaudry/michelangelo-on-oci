{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "ma-lifecycle-logs",
        "namespace": "ma-system"
      },
      "spec": {
        "type": "ClusterIP",
        "selector": {
          "app": "ma-lifecycle-logs"
        },
        "ports": [
          {
            "name": "http",
            "port": 8080,
            "targetPort": 8080
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "ma-lifecycle-logs",
        "namespace": "ma-system"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "ma-lifecycle-logs"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "ma-lifecycle-logs"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "imagePullSecrets": [
              {
                "name": "ma-lifecycle-runtime-registry"
              }
            ],
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 65532,
              "runAsGroup": 65532,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "nodeSelector": {
              "workload.oci.oracle.com/pool": "cpu"
            },
            "tolerations": [
              {
                "key": "workload.oci.oracle.com/pool",
                "operator": "Equal",
                "value": "cpu",
                "effect": "NoSchedule"
              }
            ],
            "containers": [
              {
                "name": "logs",
                "image": "REPLACE_LOG_READER_IMAGE_DIGEST_URI",
                "command": [
                  "python3",
                  "/opt/michelangelo/log_server.py"
                ],
                "envFrom": [
                  {
                    "configMapRef": {
                      "name": "ma-lifecycle-runtime-artifacts"
                    }
                  },
                  {
                    "secretRef": {
                      "name": "ma-lifecycle-runtime-artifacts"
                    }
                  }
                ],
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 8080
                  }
                ],
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "readOnlyRootFilesystem": true
                },
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "cpu": "250m",
                    "memory": "256Mi"
                  }
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": "http"
                  },
                  "periodSeconds": 5
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "ma-lifecycle-logs-private",
        "namespace": "ma-system"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app": "ma-lifecycle-logs"
          }
        },
        "policyTypes": [
          "Ingress"
        ],
        "ingress": [
          {
            "from": [
              {
                "podSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/instance": "michelangelo",
                    "app.kubernetes.io/component": "ui"
                  }
                }
              }
            ],
            "ports": [
              {
                "protocol": "TCP",
                "port": 8080
              }
            ]
          }
        ]
      }
    }
  ]
}
